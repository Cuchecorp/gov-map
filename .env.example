# Observatorio del Congreso 360 — plantilla de variables de entorno.
# Copiar a `.env` y rellenar con valores reales. NUNCA commitear `.env`.

# --- LLM / Embeddings ---
GEMINI_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=

# --- Cloudflare R2 (crudo inmutable) ---
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
TOKEN_VALUE_R2=

# --- Supabase ---
SUPABASE_PROJECT_ID=
SUPABASE_SECRET_KEY=
SUPABASE_API_URL=
# Alias canonico de SUPABASE_API_URL (mismo valor). Lo leen app/lib/supabase-admin.ts,
# app/lib/web-reader-jwt.ts y varios CLIs como `SUPABASE_URL ?? SUPABASE_API_URL`.
SUPABASE_URL=
# Clave publica (anon) del proyecto Supabase — SAFE para el navegador, NO bypasa RLS.
# La lee app/lib/supabase.ts (createServerSupabase usa el anon key como apikey de Kong).
SUPABASE_ANON_KEY=
# Clave publishable (sb_publishable_...) del proyecto Supabase — bajo privilegio,
# RLS-gated. La lee app/lib/supabase-user.ts (createServerClient de @supabase/ssr para
# la sesion de usuario / auth OTP). NO es la anon legacy (muerta, 0044) ni la service
# key (sb_secret_, bypasa RLS). Server-side; SIN prefijo NEXT_PUBLIC_; se setea como
# wrangler secret en el Worker.
SUPABASE_PUBLISHABLE_KEY=
# URL directa de Postgres (NO la API REST) — la usan los CLIs de lobby/dinero/probidad
# para DDL/bulk. Dashboard -> Settings -> Database. Formato:
# postgresql://postgres:<password>@<host>:5432/postgres
SUPABASE_DB_URL=
# JWT secret del proyecto para firmar el token web_reader (LOCKDOWN-03).
# Obtener en Dashboard -> Settings -> API -> JWT Settings -> JWT Secret.
# NO es SUPABASE_SECRET_KEY (sb_secret_...): esa es la service key (bypasa RLS).
SUPABASE_JWT_SECRET=

# --- Ingest worker ---
# CR-01/CR-04: secreto DEDICADO de invocacion del worker, separado del
# service_role. El dispatcher SQL lo envia como `Authorization: Bearer <secret>`
# y el worker lo valida (constant-time). NUNCA reutilizar el service_role aqui.
# En Postgres se setea como secreto de vault `ingest_worker_secret` o
# `alter database postgres set app.settings.ingest_worker_secret = '<secret>'`.
INGEST_WORKER_SECRET=
# CR-03 (solo dev/CI): hosts extra permitidos sobre http para E2E (coma-separados),
# p.ej. `dummy.local`. En produccion dejar VACIO (allowlist = solo https gob).
INGEST_ALLOW_TEST_HOSTS=
# WR-05 (CI backfill): numero de iteraciones del backfill (entero 1..1000).
BACKFILL_ITERATIONS=1

# Mapeo canonico de secretos (IN-03):
#   worker (Deno.env)        ->  Postgres (migracion 0003)
#   SUPABASE_API_URL         ->  app.settings.project_url / vault 'project_url'
#   SUPABASE_SECRET_KEY      ->  service_role (solo cliente supabase-js server-side)
#   INGEST_WORKER_SECRET     ->  app.settings.ingest_worker_secret / vault 'ingest_worker_secret'

# --- Gate de exposicion MONEY (Ley 21.719, Phase 13) ---
# Candado B (presentacion) del doble candado de exposicion MONEY (LEGAL-01, D-25).
# Default OFF. NO es un secreto: es un booleano de feature.
# Encender SOLO tras sign-off legal humano (signoff: approved en
# docs/legal/13-LEGAL-DOSSIER.md; deuda de operador F13). Server-only, leido por
# app/lib/money-gate.ts; solo el literal "true" lo enciende (cualquier otro valor
# => false, fail-closed). NUNCA prefijar NEXT_PUBLIC_ (no debe llegar al bundle del
# navegador). No anadir canal Postgres (app.settings.money_public_enabled) aqui: el
# consumidor declarado es Next.js server-side; Phases 14-16 lo agregaran si un RPC
# llega a consultar el flag.
MONEY_PUBLIC_ENABLED=false

# --- Gate de exposicion VSIM (similitud de votacion, Phase 102) ---
# Candado B (presentacion) de la seccion de similitud de votacion (coincidencia de
# votos entre dos parlamentarios) en la superficie publica /comparar (VSIM-02).
# Default OFF. NO es un secreto: es un booleano de feature.
# Encender SOLO tras sign-off legal humano (signoff: approved en
# docs/legal/102-LEGAL-DOSSIER-VSIM.md). La similitud de votacion cruza la linea
# anti-DW-NOMINATE (insinuacion de afinidad/coordinacion) si se enciende sin el
# caveat legal aprobado. Server-only, leido por app/lib/vsim-gate.ts; solo el
# literal "true" lo enciende (cualquier otro valor => false, fail-closed). NUNCA
# prefijar NEXT_PUBLIC_ (no debe llegar al bundle del navegador).
VSIM_PUBLIC_ENABLED=false

# --- Gate de exposicion NOTIF (captura publica de suscripciones, Phase 103) ---
# Candado B (presentacion) de la superficie publica de suscripcion ("Seguir" en las
# fichas de proyecto/parlamentario + el centro de cuenta) (NOTIF-05).
# Default OFF. NO es un secreto: es un booleano de feature.
# Encender SOLO tras sign-off legal humano (signoff: approved en
# docs/legal/103-LEGAL-DOSSIER-NOTIF.md: base de licitud + DPA proveedor + ARCO-P
# Ley 21.719). DISTINCION vs VSIM/MONEY: el operador PRE-AUTORIZO el flip esta corrida,
# PERO este ejemplo committeado SIGUE en =false y el flip ocurre a DEPLOY-TIME (env var
# del Worker), NUNCA se committea =true. Server-only, leido por app/lib/notif-gate.ts;
# solo el literal "true" lo enciende (cualquier otro valor => false, fail-closed). NUNCA
# prefijar NEXT_PUBLIC_ (no debe llegar al bundle del navegador).
NOTIF_PUBLIC_ENABLED=false

# --- Resend (envio de email del digest, conector @obs/notificaciones, Phase 103) ---
# API key de Resend (resend.com) para el envio del digest diario por email (patron
# EGRESO: el destinatario es Resend, no una fuente gubernamental). Secreto de OPERADOR,
# server-only, leido SOLO por @obs/notificaciones (nunca por argv, nunca al cliente,
# jamas interpolado en logs junto al email del destinatario). SIN esta key, el CLI del
# digest degrada a dry-run (no envia, no fabrica) — espejo del dry-run de @obs/dinero.
# Se setea como secret de GitHub Actions (cron digest-daily.yml). NO prefijar NEXT_PUBLIC_.
RESEND_API_KEY=

# --- Secreto de derivacion de tokens opacos confirm/baja (NOTIF-04, Phase 103, CR-01/CR-02) ---
# Secreto de servidor con el que se DERIVAN de forma determinista los tokens opacos del
# email: raw = base64url(HMAC-SHA256(NOTIF_TOKEN_SECRET, `${purpose}:${suscripcion_id}`)).
# La DB guarda SOLO sha256(raw) (hash-at-rest); el CRON del digest reproduce el mismo raw
# para el link SIN persistir el crudo. Server-only, secreto de OPERADOR: una filtracion de
# la DB NO permite forjar tokens (hace falta este secreto). Usado por app/app/notificaciones/
# token.ts (al suscribir) y por @obs/notificaciones (al enviar) — MISMO valor en ambos
# entornos, o los links de baja/confirmacion no resolveran. Generar aleatorio (p.ej.
# `openssl rand -base64 48`). NUNCA rotar sin re-derivar/invalidar los tokens vigentes.
# Se setea como secret de GitHub Actions (cron) y como env var del Worker. NO NEXT_PUBLIC_.
NOTIF_TOKEN_SECRET=

# --- Gate de la superficie ADMIN de revision de terceros (ENT-04, Phase 35) ---
# Habilita la ruta interna protegida /admin/revisar-entidades (cola de adjudicacion
# humana de entidad_tercero). Default OFF (fail-closed): solo el literal "true" la
# enciende; con OFF la ruta 404 sin filtrar la cola PII. Server-only, leido por
# app/lib/admin-gate.ts. NO es superficie publica. NUNCA prefijar NEXT_PUBLIC_.
ADMIN_REVISION_ENABLED=false

# Alias historico de la service-role key. Lo leen los CLIs de ingesta (lobby/dinero/
# probidad) como `SUPABASE_SERVICE_KEY ?? SUPABASE_LOCAL_SERVICE_KEY`. La superficie
# admin (app/lib/supabase-admin.ts) ahora PREFIERE SUPABASE_SECRET_KEY (arriba) y cae a
# este como fallback — basta con setear SUPABASE_SECRET_KEY en Cloudflare. Mismo valor
# que SUPABASE_SECRET_KEY (ambas = service_role; NO la anon). SECRETO de operador,
# server-only, JAMAS al bundle del navegador. NUNCA prefijar NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=

# --- ChileCompra / Mercado Publico (conector @obs/dinero, Phase 14) ---
# Ticket de la API de Mercado Publico (api.mercadopublico.cl). Secreto de OPERADOR:
# se obtiene con Clave Unica (formulario), limite ~10.000 solicitudes/dia/ticket.
# Server-only, leido SOLO de env por @obs/dinero (nunca por argv, nunca al cliente,
# jamas interpolado en mensajes de error). SIN este ticket, el CLI de @obs/dinero
# degrada a dry-run (InMemory) y NUNCA fabrica contratos. NO prefijar NEXT_PUBLIC_.
MERCADOPUBLICO_TICKET=

# --- SERVEL / financiamiento de campana (conector @obs/dinero, Phase 15) ---
# Bucket de Supabase Storage donde se versiona el crudo .xlsx de SERVEL (clave
# servel/<eleccion>/<fecha>/<hash>.xlsx). El OPERADOR crea el bucket privado
# (checkpoint). Defaultable en codigo a "crudo-servel" si se deja vacio. La fuente
# SERVEL es PUBLICA (Azure Blob, GET anonimo) -> NO requiere credencial propia.
# El crudo va a Supabase Storage porque R2 devuelve 401 (deuda de operador). El
# enlace del candidato por NOMBRE usa el provider LLM del pipeline (@obs/adjudication),
# cuyas credenciales (GEMINI/MINIMAX/DEEPSEEK) ya estan arriba — NO duplicarlas.
SERVEL_CRUDO_BUCKET=crudo-servel

# --- Frontend (Next.js / Cloudflare Pages) ---
# Controla <meta name="robots"> en app/app/layout.tsx: el literal "true" => indexable;
# cualquier otro valor (o ausente) => noindex. Server-only, NO prefijar NEXT_PUBLIC_.
PUBLIC_INDEXABLE=false

# --- Dev local (Supabase CLI: `supabase start`) ---
# Override opcional para apuntar los CLIs de ingesta al stack Supabase local en vez de
# PROD. Si se setean, varios CLIs los prefieren sobre SUPABASE_API_URL / SUPABASE_SERVICE_KEY.
# Dejar VACIO en operacion normal (los CLIs apuntan a PROD via las vars de arriba).
SUPABASE_LOCAL_URL=
SUPABASE_LOCAL_SERVICE_KEY=

# --- Capa LLM escalonada: candidatos del benchmark 107 (VEREDICTO LIVE, Plan 03) ---
# El agente JAMAS carga valores aqui; el operador los pone en .env LOCAL (nunca aqui).
# Cloudflare API token con permiso Workers AI (candidato PRIMARIO Granite
# @cf/ibm-granite/granite-4.0-h-micro; baseURL Workers AI OpenAI-compat).
WORKERS_AI_API_TOKEN=
# Id de cuenta Cloudflare — completa el baseURL Workers AI
# https://api.cloudflare.com/client/v4/accounts/{ACCOUNT_ID}/ai/v1
CLOUDFLARE_ACCOUNT_ID=
# Key sk-or-... de OpenRouter (Phi-4-mini microsoft/phi-4-mini-instruct + fallback baseURL-swap de Granite).
OPENROUTER_API_KEY=

# --- Gates LIVE de observación de la escalera de clasificación (INTEG-01/INTEG-03, Plan 109-03) ---
# Vacío = skip limpio; el literal "1" activa la prueba LIVE correspondiente. NUNCA en CI.
# El agente NUNCA carga valores aquí; el operador los pone en .env LOCAL (nunca aquí).
#
# shadow-eval: corre Granite en sombra vs DeepSeek sobre GOLDEN_SET_GATE (10 casos),
#   reporta acuerdo/desacuerdo. Requiere también WORKERS_AI_API_TOKEN + CLOUDFLARE_ACCOUNT_ID.
CLASIFICACION_SHADOW_LIVE=
#
# drift-canary: hace una probe mínima al endpoint Workers AI y compara el modelo servido
#   contra el pinneado (@cf/ibm-granite/granite-4.0-h-micro). Si difieren, invalida el
#   veredicto full-40 (2026-07-27) — re-correr el benchmark antes de promover.
#   Requiere también WORKERS_AI_API_TOKEN + CLOUDFLARE_ACCOUNT_ID.
CLASIFICACION_DRIFT_CHECK=

# --- Gate de la escalera de clasificación (INTEG-01, Plan 109-02) ---
# Config-flip de operador: solo setear a "1" TRAS shadow-eval verde sostenido
# (benchmark golden ≥7/10 con Granite VIVO). Default VACÍO = incumbente DeepSeek
# (byte-idéntico, INTEG-03). El agente NUNCA setea esta variable.
# Server-only: leída por packages/cruces/src/clasificar-fichas-cli.ts (resolverProvider).
CLASIFICACION_ESCALERA=
